# Settings for docker-compose.yml. Copy to `.env` next to docker-compose.yml.
# All values are optional. See docs/docker.md.

# Port the web app is published on.
HOMEYVIBE_PORT=80

# latest = every change on main, stable = latest release, or a version like 1.2
HOMEYVIBE_TAG=latest

# MQTT broker that zigbee2mqtt publishes to. Leave as is with `--profile zigbee`.
# Set to empty (MQTT_URL=) to run without MQTT.
MQTT_URL=mqtt://mosquitto:1883
MQTT_USERNAME=
MQTT_PASSWORD=
Z2M_BASE_TOPIC=zigbee2mqtt

# 1 = simulated devices and example pages, to try HomeyVibe without hardware.
HOMEYVIBE_DEMO=0

# Seconds between automatic update checks.
UPDATE_INTERVAL=3600

# Zigbee adapter for `--profile zigbee`, ideally from /dev/serial/by-id/
ZIGBEE_ADAPTER=/dev/ttyUSB0

TZ=Europe/Berlin
